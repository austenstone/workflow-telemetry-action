{
  "name": "workflow-telemetry-action",
  "version": "3.0.0-minimal",
  "private": false,
  "description": "GitHub Action to collect workflow CPU, memory, network, and disk telemetry as JSON",
  "main": "lib/index.js",
  "types": "src/types.ts",
  "exports": {
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map src/index.ts --out dist",
    "test": "echo \"No tests yet\" && exit 0",
    "all": "npm run format-check && npm run lint && npm run build && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austenstone/workflow-telemetry-action.git"
  },
  "keywords": [
    "monitoring",
    "observability",
    "telemetry",
    "github-actions",
    "benchmark"
  ],
  "author": "Austen Stone",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "systeminformation": "^5.31.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.39.4",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
