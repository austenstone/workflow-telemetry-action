{
  "name": "workflow-telemetry-action",
  "version": "3.0.0-minimal",
  "private": false,
  "description": "GitHub Action to collect workflow CPU, memory, network, and disk telemetry as JSON",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map src/index.ts --out dist",
    "test": "echo \"No tests yet\" && exit 0",
    "all": "npm run format-check && npm run lint && npm run build && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austenstone/workflow-telemetry-action.git"
  },
  "keywords": [
    "monitoring",
    "observability",
    "telemetry",
    "github-actions",
    "benchmark"
  ],
  "author": "Austen Stone",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "systeminformation": "^5.11.15"
  },
  "devDependencies": {
    "@types/node": "^16.3.3",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.25.0",
    "eslint-plugin-github": "^4.1.1",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
